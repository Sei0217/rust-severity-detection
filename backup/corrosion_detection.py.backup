import cv2
import numpy as np
import onnxruntime as ort
from picamera2 import Picamera2
import time
from datetime import datetime
import os

# Configuration
MODEL_PATH = "../models/yolov8n.onnx"
DETECTIONS_FOLDER = "../detections"
CONFIDENCE_THRESHOLD = 0.25
INPUT_SIZE = 640

# Create detections folder if it doesn't exist
os.makedirs(DETECTIONS_FOLDER, exist_ok=True)

# Class names (only corrosion in your case)
CLASS_NAMES = ["corrosion"]

def preprocess_image(image, input_size):
    """Preprocess image for YOLO input"""
    # Resize while maintaining aspect ratio
    img_height, img_width = image.shape[:2]
    scale = min(input_size / img_height, input_size / img_width)
    new_height, new_width = int(img_height * scale), int(img_width * scale)
    
    resized = cv2.resize(image, (new_width, new_height))
    
    # Create padded image
    padded = np.full((input_size, input_size, 3), 114, dtype=np.uint8)
    pad_top = (input_size - new_height) // 2
    pad_left = (input_size - new_width) // 2
    padded[pad_top:pad_top+new_height, pad_left:pad_left+new_width] = resized
    
    # Convert to float and normalize
    input_image = padded.astype(np.float32) / 255.0
    
    # Transpose to CHW format and add batch dimension
    input_image = np.transpose(input_image, (2, 0, 1))
    input_image = np.expand_dims(input_image, axis=0)
    
    return input_image, scale, pad_top, pad_left

def postprocess_detections(outputs, img_width, img_height, scale, pad_top, pad_left, conf_threshold):
    """Post-process YOLO outputs to get bounding boxes"""
    predictions = outputs[0]
    
    # YOLOv8 output format: (1, 6, 8400) where 6 = x, y, w, h, confidence, class
    predictions = np.transpose(predictions[0])  # Shape: (8400, 6)
    
    boxes = []
    scores = []
    class_ids = []
    
    for pred in predictions:
        x_center, y_center, width, height, confidence = pred[:5]
        
        if confidence >= conf_threshold:
            # Convert from center format to corner format
            x1 = x_center - width / 2
            y1 = y_center - height / 2
            x2 = x_center + width / 2
            y2 = y_center + height / 2
            
            # Adjust for padding and scale
            x1 = (x1 - pad_left) / scale
            y1 = (y1 - pad_top) / scale
            x2 = (x2 - pad_left) / scale
            y2 = (y2 - pad_top) / scale
            
            # Clip to image boundaries
            x1 = max(0, min(x1, img_width))
            y1 = max(0, min(y1, img_height))
            x2 = max(0, min(x2, img_width))
            y2 = max(0, min(y2, img_height))
            
            boxes.append([int(x1), int(y1), int(x2), int(y2)])
            scores.append(float(confidence))
            class_ids.append(0)  # Only corrosion class
    
    # Apply Non-Maximum Suppression
    if len(boxes) > 0:
        indices = cv2.dnn.NMSBoxes(boxes, scores, conf_threshold, 0.45)
        if len(indices) > 0:
            indices = indices.flatten()
            return [boxes[i] for i in indices], [scores[i] for i in indices], [class_ids[i] for i in indices]
    
    return [], [], []

def draw_detections(image, boxes, scores, class_ids):
    """Draw bounding boxes on image"""
    for box, score, class_id in zip(boxes, scores, class_ids):
        x1, y1, x2, y2 = box
        
        # Draw bounding box
        cv2.rectangle(image, (x1, y1), (x2, y2), (0, 0, 255), 2)
        
        # Draw label
        label = f"{CLASS_NAMES[class_id]}: {score:.2f}"
        (label_width, label_height), baseline = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.5, 1)
        cv2.rectangle(image, (x1, y1 - label_height - 5), (x1 + label_width, y1), (0, 0, 255), -1)
        cv2.putText(image, label, (x1, y1 - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
    
    return image

def main():
    print("Initializing Corrosion Detection System...")
    
    # Load ONNX model
    print(f"Loading model: {MODEL_PATH}")
    session = ort.InferenceSession(MODEL_PATH)
    input_name = session.get_inputs()[0].name
    print("Model loaded successfully!")
    
    # Initialize camera
    print("Initializing camera...")
    picam2 = Picamera2()
    config = picam2.create_preview_configuration(main={"size": (640, 480)})
    picam2.configure(config)
    picam2.start()
    print("Camera started!")
    
    # Warm-up
    time.sleep(2)
    
    # FPS tracking
    fps_start_time = time.time()
    fps_frame_count = 0
    fps = 0
    
    print("\n=== CORROSION DETECTION STARTED ===")
    print("Press 'q' to quit")
    print("Press 's' to manually save current frame")
    print("Auto-saves when corrosion is detected\n")
    
    try:
        while True:
            # Capture frame
            frame = picam2.capture_array()
            frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
            img_height, img_width = frame.shape[:2]
            
            # Preprocess
            input_image, scale, pad_top, pad_left = preprocess_image(frame, INPUT_SIZE)
            
            # Run inference
            inference_start = time.time()
            outputs = session.run(None, {input_name: input_image})
            inference_time = time.time() - inference_start
            
            # Post-process
            boxes, scores, class_ids = postprocess_detections(
                outputs, img_width, img_height, scale, pad_top, pad_left, CONFIDENCE_THRESHOLD
            )

	   # Debug Output
print(f"\n=== DEBUG INFO ===")
print(f"Raw output shape: {outputs[0].shape}")
print(f"Number of boxes found: {len(boxes)}")
	if len(boxes) > 0:
	print(f"Box coordinates: {boxes}")
	print(f"Scores: {scores}")
	print(f"Frame size: {img_width}x{img_height}")
            
            # Draw detections
            display_frame = frame.copy()
            if len(boxes) > 0:
                display_frame = draw_detections(display_frame, boxes, scores, class_ids)
                
                # Auto-save detected image
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                save_path = os.path.join(DETECTIONS_FOLDER, f"corrosion_{timestamp}.jpg")
                cv2.imwrite(save_path, display_frame)
                print(f"✓ Corrosion detected! Saved: {save_path}")
            
            # Calculate FPS
            fps_frame_count += 1
            if time.time() - fps_start_time >= 1.0:
                fps = fps_frame_count
                fps_frame_count = 0
                fps_start_time = time.time()
            
            # Draw FPS and inference time
            cv2.putText(display_frame, f"FPS: {fps}", (10, 30), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            cv2.putText(display_frame, f"Inference: {inference_time*1000:.1f}ms", (10, 60), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            cv2.putText(display_frame, f"Detections: {len(boxes)}", (10, 90), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            
            # Display
            cv2.imshow("Corrosion Detection", display_frame)
            
            # Handle key presses
            key = cv2.waitKey(1) & 0xFF
            if key == ord('q'):
                break
            elif key == ord('s'):
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                save_path = os.path.join(DETECTIONS_FOLDER, f"manual_{timestamp}.jpg")
                cv2.imwrite(save_path, frame)
                print(f"✓ Manually saved: {save_path}")
    
    except KeyboardInterrupt:
        print("\nInterrupted by user")
    
    finally:
        print("\nShutting down...")
        cv2.destroyAllWindows()
        picam2.stop()
        print("System stopped.")

if __name__ == "__main__":
    main()
print("\n=== CORROSION DETECTION STARTED ===")
    print("Press 'q' to quit")
    print("Press 's' to manually save current frame")
    print("Auto-saves when corrosion is detected\n")
    
