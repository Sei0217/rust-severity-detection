                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                save_path = os.path.join(DETECTIONS_FOLDER, f"manual_{timestamp}.jpg")
                cv2.imwrite(save_path, frame)
                print(f"✓ Manually saved: {save_path}")
    
    except KeyboardInterrupt:
